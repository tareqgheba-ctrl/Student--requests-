<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>منصة تسجيل الطلبات والاعتراضات</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <style> body { font-family: 'Cairo', sans-serif; } </style>
</head>
<body class="bg-gray-100 text-gray-800 min-h-screen py-8 px-4">

    <div class="max-w-xl mx-auto bg-white shadow-lg rounded-2xl p-6 md:p-8 border border-gray-200">
        
        <div class="text-center mb-6">
            <h1 class="text-2xl font-bold text-blue-700 mb-1">استمارة تسجيل المواد والاعتراضات</h1>
            <p class="text-gray-500 text-sm">يرجى تعبئة البيانات بدقة (مرة واحدة فقط)</p>
        </div>

        <form id="studentForm" class="space-y-5">
            <!-- اسم الطالب -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">اسم الطالب الثلاثي:</label>
                <input type="text" id="studentName" required class="w-full px-4 py-2.5 border rounded-xl focus:ring-2 focus:ring-blue-500 outline-none" placeholder="أدخل الاسم الثلاثي">
            </div>

            <!-- المرحلة الدراسية -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">الصف / المرحلة الدراسية:</label>
                <input type="text" id="studentGrade" required class="w-full px-4 py-2.5 border rounded-xl focus:ring-2 focus:ring-blue-500 outline-none" placeholder="مثال: عاشر علمي تحضير بكالوريا">
            </div>

            <!-- المواد المسجلة -->
            <div class="bg-blue-50 p-4 rounded-xl border border-blue-100">
                <label class="block text-sm font-semibold text-blue-900 mb-2">المواد المسجلة:</label>
                <div class="grid grid-cols-3 gap-2 text-sm">
                    <label class="flex items-center space-x-2 space-x-reverse cursor-pointer"><input type="checkbox" name="reg" value="رياضيات"> <span>رياضيات</span></label>
                    <label class="flex items-center space-x-2 space-x-reverse cursor-pointer"><input type="checkbox" name="reg" value="فيزياء"> <span>فيزياء</span></label>
                    <label class="flex items-center space-x-2 space-x-reverse cursor-pointer"><input type="checkbox" name="reg" value="كيمياء"> <span>كيمياء</span></label>
                </div>
            </div>

            <!-- مواد الاعتراض -->
            <div class="bg-amber-50 p-4 rounded-xl border border-amber-100">
                <label class="block text-sm font-semibold text-amber-900 mb-2">مواد الاستعلام عن العلامة / الاعتراض:</label>
                <div class="grid grid-cols-3 gap-2 text-sm">
                    <label class="flex items-center space-x-2 space-x-reverse cursor-pointer"><input type="checkbox" name="inq" value="رياضيات"> <span>رياضيات</span></label>
                    <label class="flex items-center space-x-2 space-x-reverse cursor-pointer"><input type="checkbox" name="inq" value="فيزياء"> <span>فيزياء</span></label>
                    <label class="flex items-center space-x-2 space-x-reverse cursor-pointer"><input type="checkbox" name="inq" value="كيمياء"> <span>كيمياء</span></label>
                </div>
            </div>

            <button type="submit" id="submitBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl transition shadow">
                إرسال الطلب
            </button>
        </form>

        <div id="successMsg" class="hidden mt-4 p-4 bg-green-50 text-green-700 text-center rounded-xl font-bold border border-green-200">
            تم إرسال طلبك بنجاح وتسجيله في القوائم الرسمية!
        </div>

    </div>

    <script>
        const FORM_URL = "https://docs.google.com/forms/d/e/1FAIpQLSeQlLXDINIiNhwNqMu--l1DGjnxpzBYfYeYTG8ir0I8iANShw/formResponse";
        
        const ENTRY_NAME  = "entry.1898175687";
        const ENTRY_GRADE = "entry.1997160338";
        const ENTRY_REG   = "entry.1257620891";
        const ENTRY_INQ   = "entry.377857694";

        document.getElementById('studentForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerText = "جاري الإرسال...";

            const name = document.getElementById('studentName').value.trim();
            const grade = document.getElementById('studentGrade').value.trim();
            const regValues = Array.from(document.querySelectorAll('input[name="reg"]:checked')).map(c => c.value);
            const inqValues = Array.from(document.querySelectorAll('input[name="inq"]:checked')).map(c => c.value);

            const formData = new FormData();
            formData.append(ENTRY_NAME, name);
            formData.append(ENTRY_GRADE, grade);
            
            regValues.forEach(val => formData.append(ENTRY_REG, val));
            inqValues.forEach(val => formData.append(ENTRY_INQ, val));

            fetch(FORM_URL, {
                method: 'POST',
                mode: 'no-cors',
                body: formData
            }).then(() => {
                document.getElementById('studentForm').reset();
                document.getElementById('successMsg').classList.remove('hidden');
                btn.disabled = false;
                btn.innerText = "إرسال الطلب";
            }).catch(err => {
                alert('حدث خطأ أثناء الإرسال، يرجى المحاولة مجدداً.');
                btn.disabled = false;
                btn.innerText = "إرسال الطلب";
            });
        });
    </script>
</body>
</html>
